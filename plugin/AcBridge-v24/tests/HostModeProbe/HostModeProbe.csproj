<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HostModeProbe</AssemblyName>
    <RootNamespace>HostModeProbe</RootNamespace>
    <!-- The plugin ships a WPF palette; the probe must be able to resolve WPF at JIT time. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <!-- Deliberately NO reference to AeccDbMgd / AecBaseMgd / AeccPressurePipesMgd:
       this process emulates a plain-AutoCAD host at the assembly-resolution level. -->
</Project>
